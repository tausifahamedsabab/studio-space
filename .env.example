# Mock mode is the default; set to "live" to use the Express API.
API_MODE=mock

# Server-side base URL for the Express API.
API_BASE_URL=http://localhost:8000

# Kept for local compatibility; API_BASE_URL takes precedence.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Enables direct browser uploads to imgbb. Leave empty to paste image URLs.
NEXT_PUBLIC_IMGBB_API_KEY=

# Google OAuth (used by /api/auth/google). Get these from Google Cloud Console.
# The authorized redirect URI is <origin>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
